# =============================================================================
# CROPWATCH ENVIRONMENT VARIABLES
# =============================================================================
# Copy to .env and adjust. .env is gitignored.
#
# NO SECRETS IN ENV FILES. Secrets live in Secret Manager (project crop-watch01)
# and are mounted into Cloud Run at deploy time; this file only names them.
#
# The Firebase web config is public client config and gets committed in
# apps/web/src/lib/firebase.ts (see CLAUDE.md), so it does not appear here.
# =============================================================================

# =============================================================================
# WEB DASHBOARD (apps/web). Vite exposes only VITE_-prefixed variables.
# =============================================================================
# tRPC endpoint of the API server
VITE_API_URL=http://localhost:3001/trpc

# =============================================================================
# API SERVER (apps/functions, Hono on Cloud Run)
# =============================================================================
# Cloud Run injects PORT=8080. Locally 3001 keeps clear of the Firestore emulator.
PORT=3001
# Comma-separated browser origins allowed to call /trpc
CORS_ORIGINS=http://localhost:5173

# Google Gen AI SDK (@google/genai) via Vertex AI. Auth is Application Default
# Credentials locally (gcloud auth application-default login) and the
# cropwatch-api service account on Cloud Run. Never a key file.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=crop-watch01
GOOGLE_CLOUD_LOCATION=europe-west1

# Resources created by infra/setup.sh
STORAGE_BUCKET=crop-watch01.firebasestorage.app
PUBSUB_ALERTS_TOPIC=cropwatch.alerts
BIGQUERY_DATASET=cropwatch

# =============================================================================
# LOCAL EMULATORS (uncomment to point the server's Admin SDK at them)
# =============================================================================
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
