# =============================================================================
# PHYTOS ENVIRONMENT VARIABLES
# =============================================================================
# Nothing here is required. Every variable has a default that runs against the
# live project (crop-watch01), so a fresh clone needs no env file at all. Set
# one only to change that default.
#
# NO SECRETS IN ENV FILES. Secrets live in Secret Manager (project crop-watch01)
# and are mounted into Cloud Run at deploy time; this file only names them.
#
# The Firebase web config is public client config and is committed in
# apps/web/src/lib/firebase.ts (see CLAUDE.md), so it does not appear here.
#
# Where each section goes:
#   Dashboard  apps/web/.env.local      (Vite reads the app's own folder)
#   Capture    apps/capture/.env.local
#   API        .env at the repo root. The API's dev script loads no file, so
#              start it with the file instead:
#              pnpm --filter @repo/functions exec tsx watch --env-file=../../.env src/server.ts
# =============================================================================

# =============================================================================
# DASHBOARD (apps/web). Vite exposes only VITE_-prefixed variables.
# =============================================================================
# The API's base URL; the dashboard calls tRPC at <base>/trpc. Default: the live API.
# For the API running locally:
# VITE_API_BASE=http://localhost:3001
# Shows the dry-spell scenario page (deploys turn it on).
VITE_FEATURE_SCENARIO=true

# =============================================================================
# CAPTURE APP (apps/capture)
# =============================================================================
# The REST contract's base URL. Default: the live API.
# For the API running locally:
# VITE_API_URL=http://localhost:3001/api/v1
# Web push key. Default: crop-watch01's public key. Empty turns push off.
# VITE_FCM_VAPID_KEY=

# =============================================================================
# API SERVER (apps/functions, Hono on Cloud Run). Defaults in apps/functions/src/env.ts.
# =============================================================================
# Cloud Run injects PORT=8080. Locally 3001 keeps clear of the Firestore emulator.
PORT=3001
# Comma-separated browser origins allowed to call the API (dashboard, capture).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth is Application Default Credentials locally (gcloud auth
# application-default login, with an account that has access to crop-watch01)
# and the cropwatch-api service account on Cloud Run. Never a key file.
GOOGLE_CLOUD_PROJECT=crop-watch01
GOOGLE_CLOUD_LOCATION=europe-west1

# Gemini through the Google Gen AI SDK on Vertex AI. europe-west1 serves no
# current Gemini model, so it runs on the EU multi-region endpoint.
GEMINI_LOCATION=eu
GEMINI_MODEL=gemini-3.5-flash-lite

# Resources created by infra/setup.sh and tools/corpus.
STORAGE_BUCKET=crop-watch01.firebasestorage.app
KNOWLEDGE_INDEX_URI=gs://crop-watch01-knowledge/index.json
BQ_DATASET=cropwatch
ALERTS_TOPIC=cropwatch.alerts

# Placeholder register rows are test data. Leave unset (false) unless a
# deliberate demo set-up needs them.
# ALLOW_PLACEHOLDER_PRODUCTS=false

# SMS through Africa's Talking. Names only: on Cloud Run they come from the
# Secret Manager secrets africastalking-username and africastalking-api-key.
# Unset locally, so alerts log the SMS they would have sent.
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=

# Cloud Run only: the identity Eventarc signs photo events with. Unset locally,
# which turns that route off.
# EVENTARC_SERVICE_ACCOUNT=

# =============================================================================
# LOCAL EMULATORS (uncomment to point the API's Admin SDK at them; ports from
# firebase.json, started with: firebase emulators:start)
# =============================================================================
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
