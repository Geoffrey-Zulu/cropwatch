{
  "openapi": "3.0.3",
  "info": {
    "title": "Phytos API",
    "version": "1.0.0",
    "description": "REST v1 for the Phytos mobile app. Generated from packages/shared Zod schemas; do not edit by hand. FROZEN: changes only add optional fields (no renames, removals or type changes), so clients MUST ignore unknown fields and MUST treat an unrecognised enum value as generic: an unknown status as in-progress, an unknown issue as \"unknown\", anything else as unknown, never as an error. Confidence and severity appear only as qualitative bands, never as numbers."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Relative to the Cloud Run service URL."
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Service status."
    },
    {
      "name": "observations",
      "description": "Report a crop-health problem and follow its diagnosis, recommendation and outcome."
    },
    {
      "name": "alerts",
      "description": "Area alerts from clusters and the prototype risk signal."
    }
  ],
  "components": {
    "securitySchemes": {
      "firebaseIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase Auth ID token. Anonymous sign-in is enough for farmers; officer permissions come from the `role` custom claim."
      }
    },
    "schemas": {
      "Crop": {
        "type": "string",
        "enum": [
          "maize",
          "tomato",
          "cabbage",
          "cassava",
          "soybean"
        ],
        "description": "Controlled vocabulary, append-only. Labels: maize = Maize; tomato = Tomato; cabbage = Cabbage; cassava = Cassava; soybean = Soybean."
      },
      "Issue": {
        "type": "string",
        "enum": [
          "fall_armyworm",
          "tuta_absoluta",
          "late_blight",
          "early_blight",
          "diamondback_moth",
          "cassava_mosaic",
          "cassava_brown_streak",
          "maize_lethal_necrosis",
          "unknown"
        ],
        "description": "Controlled vocabulary, append-only; \"unknown\" always routes to expert review. Clients MUST treat an unrecognised value as \"unknown\", never as an error. Labels: fall_armyworm = Fall armyworm; tuta_absoluta = Tuta absoluta (tomato leafminer); late_blight = Late blight; early_blight = Early blight; diamondback_moth = Diamondback moth; cassava_mosaic = Cassava mosaic disease; cassava_brown_streak = Cassava brown streak disease; maize_lethal_necrosis = Maize lethal necrosis; unknown = Unknown: needs expert review."
      },
      "Province": {
        "type": "string",
        "enum": [
          "Central",
          "Copperbelt",
          "Eastern",
          "Luapula",
          "Lusaka",
          "Muchinga",
          "Northern",
          "North-Western",
          "Southern",
          "Western"
        ]
      },
      "GeoPoint": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "DistrictSlug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "Normalised district: the aggregation key for clusters, alerts and FCM topics. Lowercase, a trailing \" district\" dropped, runs of other characters replaced by \"-\" (\"Kapiri Mposhi\" → \"kapiri-mposhi\").",
        "example": "kapiri-mposhi"
      },
      "ObservationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{16,64}$",
        "description": "Generated by the app before uploading photos (a Firestore auto-ID or a UUID v4). First writer wins: once a user has created an observation with this id, no other user can.",
        "example": "k3J9xQ2mW8pL5vR1tY7u"
      },
      "PhotoPath": {
        "type": "string",
        "pattern": "^observations\\/([A-Za-z0-9_-]{1,128})\\/([A-Za-z0-9_-]{16,64})\\/\\d{1,2}\\.jpg$",
        "description": "Cloud Storage object path in the default bucket: observations/{uid}/{obs_id}/{n}.jpg, where uid is the signed-in user (Storage rules refuse any other uid) and n is 0, 1, 2… JPEG only, under 10 MB.",
        "example": "observations/Vn1rKk5yQhWcXz0pB2sLqT4uEa83/k3J9xQ2mW8pL5vR1tY7u/0.jpg"
      },
      "ObservationStatus": {
        "type": "string",
        "enum": [
          "diagnosing",
          "awaiting_expert_review",
          "recommending",
          "complete"
        ],
        "description": "diagnosing: waiting for the AI assessment. awaiting_expert_review: routed to an officer; no recommendation until verified. recommending: diagnosis accepted (or verified), recommendation being prepared. complete: recommendation available. A verify that corrects the issue sends a complete observation back through recommending to complete. Clients MUST treat an unrecognised value as generic in-progress, never as an error."
      },
      "VerificationState": {
        "type": "string",
        "enum": [
          "UNVERIFIED",
          "AI_ASSESSED",
          "FIELD_VERIFIED",
          "EXPERT_CONFIRMED"
        ],
        "description": "Weakest to strongest. AI_ASSESSED is never set on an expert-review observation."
      },
      "ConfidenceBand": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "description": "Qualitative AI assessment (\"AI assessment: high confidence\"). Never shown as a number. low always means expert review."
      },
      "SeverityBand": {
        "type": "string",
        "enum": [
          "none",
          "low",
          "moderate",
          "severe"
        ],
        "description": "Qualitative extent of visible damage."
      },
      "ExpertReviewReason": {
        "type": "string",
        "enum": [
          "low_confidence",
          "unknown_issue",
          "invalid_model_output"
        ],
        "description": "Why a diagnosis was routed to the officer queue instead of being trusted."
      },
      "RegistrationNo": {
        "type": "string",
        "minLength": 1,
        "description": "Product registration number from the Regulatory Product Database."
      },
      "ChemicalOption": {
        "type": "object",
        "properties": {
          "registration_no": {
            "$ref": "#/components/schemas/RegistrationNo"
          },
          "trade_name": {
            "type": "string",
            "minLength": 1
          },
          "active_ingredient": {
            "type": "string",
            "minLength": 1
          },
          "label_dose": {
            "type": "string",
            "minLength": 1
          },
          "phi_days": {
            "type": "integer",
            "minimum": 0
          },
          "source_doc": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "registration_no",
          "trade_name",
          "active_ingredient",
          "label_dose",
          "phi_days",
          "source_doc"
        ],
        "description": "A registered product that passed the regulatory filter for this crop and issue. Render label_dose exactly as given (verbatim label text). phi_days is the pre-harvest interval."
      },
      "Source": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "1 MoA, 2 ZARI, 3 ZMD, 4 FAO, 5 CABI, 6 research. Lower wins on conflict."
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "tier",
          "uri"
        ]
      },
      "Diagnosis": {
        "type": "object",
        "properties": {
          "suspected_issue": {
            "$ref": "#/components/schemas/Issue"
          },
          "confidence_band": {
            "$ref": "#/components/schemas/ConfidenceBand"
          },
          "severity_band": {
            "type": "string",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SeverityBand"
              }
            ]
          },
          "visible_symptoms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs_expert_review": {
            "type": "boolean"
          },
          "expert_review_reason": {
            "type": "string",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/ExpertReviewReason"
              }
            ]
          },
          "diagnosed_at": {
            "type": "string",
            "format": "date-time"
          },
          "suspected_issue_label": {
            "type": "string"
          }
        },
        "required": [
          "suspected_issue",
          "confidence_band",
          "severity_band",
          "visible_symptoms",
          "needs_expert_review",
          "expert_review_reason",
          "diagnosed_at",
          "suspected_issue_label"
        ],
        "description": "AI assessment. Show confidence_band as words (\"AI assessment: high confidence\"), never as a number. When needs_expert_review is true, show that an officer will review instead of treatment advice."
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "ipm_steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Ordered IPM ladder: scout → cultural → biological → chemical."
          },
          "chemical_options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChemicalOption"
            }
          },
          "officer_referral": {
            "type": "boolean",
            "description": "true when no registered product passed the filter: show \"Consult an extension officer for chemical options\"."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "minItems": 1
          }
        },
        "required": [
          "ipm_steps",
          "chemical_options",
          "officer_referral",
          "sources"
        ],
        "description": "IPM-first advice. Every chemical option is a registered product for this crop and issue; nothing here is model-written dosage."
      },
      "InterventionType": {
        "type": "string",
        "enum": [
          "cultural",
          "biological",
          "chemical",
          "mixed"
        ]
      },
      "Intervention": {
        "type": "object",
        "properties": {
          "applied_at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "$ref": "#/components/schemas/InterventionType"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationNo"
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "applied_at",
          "type",
          "products",
          "notes"
        ]
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "followup_at": {
            "type": "string",
            "format": "date-time"
          },
          "severity_band": {
            "$ref": "#/components/schemas/SeverityBand"
          },
          "resolved": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "followup_at",
          "severity_band",
          "resolved",
          "notes"
        ]
      },
      "RiskLevel": {
        "type": "string",
        "enum": [
          "LOW",
          "ELEVATED",
          "HIGH"
        ],
        "description": "Qualitative prototype signal (Phytos Risk Model v0). Never a probability; always shown with its contributing factors."
      },
      "AlertType": {
        "type": "string",
        "enum": [
          "cluster",
          "risk_change",
          "org_priority"
        ]
      },
      "AlertClass": {
        "type": "string",
        "enum": [
          "weather_advisory",
          "verified_cluster",
          "model_risk_signal"
        ],
        "description": "weather_advisory: forecast conditions only, no report confirms it. verified_cluster: the cluster rule is met and at least one report in it was verified by an officer. model_risk_signal: Risk Model v0 over AI-assessed reports, not yet verified. Treat a missing or unknown value as model_risk_signal."
      },
      "Alert": {
        "type": "object",
        "properties": {
          "alert_id": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AlertType"
          },
          "issue": {
            "$ref": "#/components/schemas/Issue"
          },
          "issue_label": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "district_slug": {
            "$ref": "#/components/schemas/DistrictSlug"
          },
          "level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "contributing_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "geo_center": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "radius_km": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "sim": {
            "type": "boolean"
          },
          "alert_class": {
            "$ref": "#/components/schemas/AlertClass"
          },
          "reports": {
            "type": "integer",
            "minimum": 0
          },
          "verified_reports": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "alert_id",
          "type",
          "issue",
          "issue_label",
          "district",
          "district_slug",
          "level",
          "contributing_factors",
          "geo_center",
          "radius_km",
          "created_at",
          "sim"
        ],
        "description": "Area alert. Always show level together with contributing_factors, and the alert_class label with its uncertainty wording when present."
      },
      "AlertPushData": {
        "type": "object",
        "properties": {
          "alert_id": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AlertType"
          },
          "issue": {
            "$ref": "#/components/schemas/Issue"
          },
          "district": {
            "type": "string"
          },
          "district_slug": {
            "$ref": "#/components/schemas/DistrictSlug"
          },
          "level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "sim": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          }
        },
        "required": [
          "alert_id",
          "type",
          "issue",
          "district",
          "district_slug",
          "level",
          "title",
          "body",
          "sim"
        ],
        "description": "FCM data payload, sent to topic \"alerts-\" + district_slug (e.g. \"alerts-kapiri-mposhi\"; subscribe using the district_slug the API returns). All values are strings, as FCM requires. body always includes the contributing factors. Fetch the full alert with GET /alerts."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "ObservationCreated": {
        "type": "object",
        "properties": {
          "obs_id": {
            "$ref": "#/components/schemas/ObservationId"
          },
          "status": {
            "$ref": "#/components/schemas/ObservationStatus"
          }
        },
        "required": [
          "obs_id",
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized",
              "forbidden",
              "not_found",
              "validation_failed",
              "conflict",
              "not_implemented",
              "internal"
            ]
          },
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateObservationRequest": {
        "type": "object",
        "properties": {
          "obs_id": {
            "$ref": "#/components/schemas/ObservationId"
          },
          "crop": {
            "$ref": "#/components/schemas/Crop"
          },
          "location": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "district": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Offer these names in the picker; any other name is accepted and normalised to a district_slug. Central: Kabwe, Kapiri Mposhi, Mkushi, Serenje, Mumbwa, Chibombo, Chisamba. Copperbelt: Ndola, Kitwe, Chingola, Mufulira, Luanshya, Kalulushi, Chililabombwe, Masaiti, Mpongwe, Lufwanyama. Eastern: Chipata, Katete, Lundazi, Petauke, Nyimba, Chadiza, Mambwe, Sinda, Vubwi. Luapula: Mansa, Kawambwa, Nchelenge, Samfya, Mwense. Lusaka: Lusaka, Chongwe, Kafue, Luangwa, Chilanga, Rufunsa. Muchinga: Chinsali, Mpika, Nakonde, Isoka, Chama. Northern: Kasama, Mbala, Mporokoso, Mungwi, Luwingu, Kaputa, Mpulungu. North-Western: Solwezi, Kasempa, Mwinilunga, Zambezi, Kabompo, Chavuma, Mufumbwe. Southern: Livingstone, Choma, Mazabuka, Monze, Kalomo, Namwala, Gwembe, Siavonga, Sinazongwe, Kazungula. Western: Mongu, Kaoma, Senanga, Sesheke, Kalabo, Lukulu.",
            "example": "Chongwe"
          },
          "province": {
            "$ref": "#/components/schemas/Province"
          },
          "camp": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 64
          },
          "planting_date": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "growth_stage": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 64,
            "example": "flowering"
          },
          "photo_paths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhotoPath"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "farmer_description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "required": [
          "obs_id",
          "crop",
          "location",
          "district",
          "province",
          "photo_paths"
        ],
        "description": "Upload the photos to Storage first, then send this. location is the device GPS fix. The uid in every photo path must be the caller (otherwise 403)."
      },
      "Observation": {
        "type": "object",
        "properties": {
          "obs_id": {
            "$ref": "#/components/schemas/ObservationId"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "crop": {
            "$ref": "#/components/schemas/Crop"
          },
          "district": {
            "type": "string"
          },
          "district_slug": {
            "$ref": "#/components/schemas/DistrictSlug"
          },
          "province": {
            "$ref": "#/components/schemas/Province"
          },
          "camp": {
            "type": "string",
            "nullable": true
          },
          "planting_date": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "growth_stage": {
            "type": "string",
            "nullable": true
          },
          "photo_paths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhotoPath"
            }
          },
          "farmer_description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/ObservationStatus"
          },
          "verification_state": {
            "$ref": "#/components/schemas/VerificationState"
          },
          "verified_issue": {
            "type": "string",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Issue"
              }
            ]
          },
          "diagnosis": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Diagnosis"
              }
            ]
          },
          "recommendation": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Recommendation"
              }
            ]
          },
          "intervention": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Intervention"
              }
            ]
          },
          "outcome": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Outcome"
              }
            ]
          },
          "sim": {
            "type": "boolean",
            "description": "true for simulated demo data: show the DEMO DATA · SIMULATED badge."
          }
        },
        "required": [
          "obs_id",
          "created_at",
          "crop",
          "district",
          "district_slug",
          "province",
          "camp",
          "planting_date",
          "growth_stage",
          "photo_paths",
          "farmer_description",
          "status",
          "verification_state",
          "verified_issue",
          "diagnosis",
          "recommendation",
          "intervention",
          "outcome",
          "sim"
        ]
      },
      "VerifyRequest": {
        "type": "object",
        "properties": {
          "verified_issue": {
            "$ref": "#/components/schemas/Issue"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "required": [
          "verified_issue"
        ],
        "description": "Officer confirms or corrects the diagnosis. field_officer and extension_officer set FIELD_VERIFIED; agronomist and admin set EXPERT_CONFIRMED. An observation awaiting expert review moves to recommending; a verify that changes the issue re-triggers the recommendation (status → recommending → complete)."
      },
      "InterventionRequest": {
        "type": "object",
        "properties": {
          "applied_at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "$ref": "#/components/schemas/InterventionType"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationNo"
            },
            "maxItems": 10
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "required": [
          "applied_at",
          "type",
          "products"
        ]
      },
      "OutcomeRequest": {
        "type": "object",
        "properties": {
          "followup_at": {
            "type": "string",
            "format": "date-time"
          },
          "severity_band": {
            "$ref": "#/components/schemas/SeverityBand"
          },
          "resolved": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "required": [
          "followup_at",
          "severity_band",
          "resolved"
        ]
      },
      "AlertList": {
        "type": "object",
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          }
        },
        "required": [
          "alerts"
