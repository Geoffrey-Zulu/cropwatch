server/dist
public/dist
*.pem

# Dashboard preview fixtures (generated from the seed, dev only)
apps/web/src/dev/fixtures.local.json

# Personal working files (CVs, notes), never committed
Claude outputs/

# Working debris: kept on disk, never in the repository
