{
  "name": "@repo/functions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:diagnose": "tsx src/eval/diagnoseEval.ts",
    "eval:recommend": "tsx src/eval/recommendEval.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^2.1.5",
    "@repo/shared": "workspace:*",
    "@trpc/server": "^11.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.9.1",
    "hono": "^4.13.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
